NEXT_PUBLIC_AMPLITUDE_API_KEY=your_amplitude_api_key_here
NEXT_PUBLIC_API_URL=http://localhost:8000

# 결제(PayApp)는 서버 to 서버 통신 — FE 환경변수 불필요.
# 결제 키는 BE의 PAYAPP_USERID/LINKKEY/LINKVAL 에서 관리.

# 채팅(도화선 2.0) 실 BE 배선 스위치 — 미설정(주석 유지) 시 100% 로컬 목업(네트워크 호출 0).
# 값을 채우면(보통 NEXT_PUBLIC_API_URL과 동일 origin) chatApi가 방 get-or-create/히스토리/SSE를
# 실 BE(/api/chat/rooms...)로 호출한다. P4-3 전까지 배포 환경에서는 미설정 유지.
# NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000
